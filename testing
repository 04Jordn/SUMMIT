    local NameLbl = Create("TextLabel", Holder or Content, { Text = Props.Name or "", TextColor3 = Theme.SubText,
        TextSize = L.TitleSize, TextXAlignment = TXA.Left,
        TextTruncate = ETT.AtEnd, Size = UD2(1, 0, 0, 15), LayoutOrder = 1 })
    Create("UIFlexItem", Holder or NameLbl, { FlexMode = Enum.UIFlexMode.Fill })
    if HasDesc then
