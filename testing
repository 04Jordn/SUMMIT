--!mv:cff
function Library:Init()
    if Private.Started then return end
    Private.Started = true
    if not self:Authorise() then return end

    table.insert(Private.Tabs, { Name = "Settings", Settings = true })
    local Rank = {}
    for I, Name in TC(self.TabOrder or {}) do Rank[Name] = I end
    for I, T in Private.Tabs do T.Seq = I end
    table.sort(Private.Tabs, function(A, B)
        local Ra, Rb = Rank[A.Name] or math.huge, Rank[B.Name] or math.huge
        if Ra ~= Rb then return Ra < Rb end
        return A.Seq < B.Seq
    end)

    local Check = KeyCheck()
    if Check and not Private.Premium then
        ShowKeyGate(Check, BuildHub)
    else
        TDF(BuildHub)
    end
end

