--!mv:cff
local function KeyCheck()
    local KeyConfig = Config.KEY
    local LocalKeys = type(KeyConfig.Keys) == "table" and #KeyConfig.Keys > 0
    if not KeyConfig.Enabled or not (LocalKeys or ApiBase() ~= "") then return nil end

    local function Normalise(S) return (tostring(S):gsub("%s", ""):gsub("%c", ""):lower()) end

    local function MatchesLocal(Entered)
        for _, K in KeyConfig.Keys or {} do
            if Entered == Normalise(K) then return true end
        end
        return false
    end

    return function(Typed)
        local Entered = Normalise(Typed)
        if Entered == "" then return false end
        if ApiBase() == "" then return MatchesLocal(Entered) end
        local Data, Err = ApiCall("/key", "?k=" .. HttpService:UrlEncode(Entered), { key = Entered })
        if Data and Data.valid == true then return true end
        if Data and Data.reason ~= "not_configured" then return false end
        if not Data then
            Warn("key check failed: %s", tostring(Err))
            if not LocalKeys then return false, true end
        end
        return MatchesLocal(Entered)
    end
end

