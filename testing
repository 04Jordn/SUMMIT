-------------------------------------------------------------------------- input & drag

local function IsPress(T) return T == UIT.MouseButton1 or T == UIT.Touch end
local function IsMove(T) return T == UIT.MouseMovement or T == UIT.Touch end

local DragScope = NewScope()
Lifetime.Add(DragScope.Clean)

local function BeginDrag(OnMove)
    DragScope.Clean()
    local Latest
    local function Note(I)
        if IsMove(I.UserInputType) then Latest = I end
    end
    local function Apply()
        if Latest then local I = Latest; Latest = nil; OnMove(I) end
    end
    DragScope.Add(UserInputService.InputChanged:Connect(Note))
    DragScope.Add(RunService.PreRender:Connect(Apply))
    DragScope.Add(UserInputService.InputEnded:Connect(function(I)
        if IsPress(I.UserInputType) then DragScope.Clean() end
    end))
    DragScope.Add(function() if Latest then OnMove(Latest); Latest = nil end end)
end

local function BindSlider(Object, Lock, OnMove)
    local function Update(Input)
        local Origin, Size = Object.AbsolutePosition, Object.AbsoluteSize
        OnMove(V2(
            Size.X > 0 and MC((Input.Position.X - Origin.X) / Size.X, 0, 1) or 0,
            Size.Y > 0 and MC((Input.Position.Y - Origin.Y) / Size.Y, 0, 1) or 0))
    end
    Object.InputBegan:Connect(function(Input)
        if not IsPress(Input.UserInputType) then return end
        Update(Input)
        BeginDrag(Update)
        Private.SliderDragging = true
        if Lock then Lock.ScrollingEnabled = false end
        DragScope.Add(function()
            Private.SliderDragging = false
            if Lock then Lock.ScrollingEnabled = true end
        end)
    end)
end

local function SetTopLeft(Target, Vp, X, Y)
    local Size, Ap, Pos = Target.AbsoluteSize, Target.AnchorPoint, Target.Position
    Target.Position = UD2(Pos.X.Scale, X + Size.X * Ap.X - Vp.X * Pos.X.Scale,
                                Pos.Y.Scale, Y + Size.Y * Ap.Y - Vp.Y * Pos.Y.Scale)
end

local function MakeDraggable(Handle, Target, OnStart, OnMoving)
    Target = Target or Handle
    Handle.InputBegan:Connect(function(Input)
        if not IsPress(Input.UserInputType) then return end
        if OnStart then OnStart() end
        local Host = Target.Parent
        local StartTL = Target.AbsolutePosition - (Host and Host.AbsolutePosition or Vector2.zero)
        local Origin, Active, Done = Input.Position, false, false
        BeginDrag(function(I)
            if Done then return end
            local Delta = I.Position - Origin
            if not Active and Delta.Magnitude < 5 then return end
            if not Active and OnMoving then OnMoving(true) end
            Active = true
            local Vp = Host and Host.AbsoluteSize or V2(1280, 720)
            local Size = Target.AbsoluteSize
            SetTopLeft(Target, Vp,
                MC(StartTL.X + Delta.X, 100 - Size.X, Vp.X - 100),
                MC(StartTL.Y + Delta.Y, 0, Vp.Y - 44))
        end)
        DragScope.Add(function()
            Done = true
            if Active and OnMoving then OnMoving(false) end
        end)
    end)
end

local function DragFree(Face, Holder, Gui, OnTap, Locked, OnMoved)
    local Start, Origin, Moved
    Face.InputBegan:Connect(function(Input)
        if not IsPress(Input.UserInputType) then return end
        Start, Moved = Input.Position, false
        if Locked and Locked() then return end
        Origin = Holder.AbsolutePosition - Gui.AbsolutePosition
        Holder.AnchorPoint = Vector2.zero
        Holder.Position = UFO(Origin.X, Origin.Y)
        BeginDrag(function(I)
            local Delta = I.Position - Start
            if Delta.Magnitude > 6 and not Moved then
                Moved = true
                if OnMoved then OnMoved() end
            end
            local Vp = Gui.AbsoluteSize
            Holder.Position = UFO(
                MC(Origin.X + Delta.X, 4, MX(4, Vp.X - Holder.AbsoluteSize.X - 4)),
                MC(Origin.Y + Delta.Y, 4, MX(4, Vp.Y - Holder.AbsoluteSize.Y - 4)))
        end)
    end)
    Face.InputEnded:Connect(function(Input)
        if IsPress(Input.UserInputType) and not Moved then OnTap() end
    end)
end

