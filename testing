--!mv:vm
local function ApiBase()
    local Base = Config.API
    if type(Base) ~= "string" or Base == "" then return "" end
    return (Base:gsub("/+$", ""))
end

--!mv:cff
local function ApiCall(Path, Query, Body)
    local Base = ApiBase()
    if Base == "" or not Env.Request then return nil, "no api" end
    local Req = { Url = Base .. Path .. (Query or ""), Method = Body and "POST" or "GET",
        Headers = { ["X-SummitX-Auth"] = tostring(Config.API_SECRET or "") } }
    if Body then
        Req.Headers["Content-Type"] = "application/json"
        Req.Body = HttpService:JSONEncode(Body)
    end
    local Sent, Res = pcall(Env.Request, Req)
    if not Sent or type(Res) ~= "table" then return nil, tostring(Res) end
    local Code = tonumber(Res.StatusCode)
    if Code and (Code < 200 or Code >= 300) then
        return nil, ("HTTP %d %s"):format(Code, tostring(Res.Body or ""):sub(1, 80))
    end
    local Ok, Data = pcall(HttpService.JSONDecode, HttpService, Res.Body or "")
    if not Ok or type(Data) ~= "table" then return nil, "not valid JSON" end
    return Data
end

--!mv:cff
local function RunSession()
    local OkId, Hwid = pcall(function()
        return type(gethwid) == "function" and gethwid() or Service("RbxAnalyticsService"):GetClientId()
    end)
    local Body = { uid = LocalPlayer.UserId, place_id = game.PlaceId, hub = Config.HUB_NAME,
        executor = Env.Executor, hwid = OkId and Hwid and tostring(Hwid) or nil }
    local Data, Err
    for Attempt = 1, 2 do
        Data, Err = ApiCall("/session", nil, Body)
        if Data or Err == "no api" then break end
        if Attempt == 1 then task.wait(1.5) end
    end
    if not Data then
        if Err ~= "no api" then Warn("session check failed: %s", tostring(Err)) end
        Library:SetPremium(false, "free")
        return
    end
    Private.StoreUrl = type(Data.store) == "string" and Data.store ~= "" and Data.store or nil
    if Data.blocked then Library:SetPremium(false, "blocked") else Library:SetPremium(Data.premium == true) end
end

--!mv:cff
function Library:Authorise()
    if Private.Authorised ~= nil then return Private.Authorised end
    Private.RestoreTheme()
    TSP(RunSession)
    Private.Authorised = self:Allowed()
    return Private.Authorised
end

