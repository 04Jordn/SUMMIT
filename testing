        BackgroundTransparency = 1, Active = true, Visible = false, ZIndex = 160 })
    local Scale = Create("UIScale", Root, { Scale = L.ScaleBase })
    local Shadow = DropShadow(Root, 120, 0.62, 0)
    local Main, MainStroke = GlassCard(Root, { Size = UFS(1, 1), Active = true, ZIndex = 1 })

    local Ghost = Create("Frame", Root, { Size = UFS(1, 1), BackgroundColor3 = ColorBlack, BackgroundTransparency = 1,
        Visible = false, ZIndex = 2 })
    local _, GhostStroke = Decorate(Ghost, L.Corner12, { ColorWhite, 1, 1.5 })
    local GhostText = Create("TextLabel", Ghost, { Text = (tostring(Opts.Discord or ""):gsub("^%w+://", "")):upper(),
        Rotation = -20, AnchorPoint = V2(0.5, 0.5), Position = UFS(0.5, 0.5), Size = UFS(0.88, 0.26),
        TextColor3 = ColorWhite, TextTransparency = 1, TextScaled = true })

    self.Gui, self.Root, self.Scale, self.Main = Gui, Root, Scale, Main
    self.Fader = FaderClass.new(Root, { [Ghost] = true }, { [Root] = true, [Shadow] = true, [Main] = true, [MainStroke] = true }, ResetInteractives)

    local DragFade, DragGen = 0.15, 0
    self.DragGhost = function(Moving)
        DragGen += 1
        local Gen = DragGen
        if Moving then
            self.Fader:Out(DragFade)
            Ghost.Visible = true
            Tween(Ghost, { BackgroundTransparency = 0.45 }, DragFade)
            Tween(GhostStroke, { Transparency = 0.7 }, DragFade)
            Tween(GhostText, { TextTransparency = 0.1 }, DragFade)
            TDL(DragFade + 0.02, function() if Gen == DragGen then Main.Visible = false end end)
        else
            Main.Visible = true
            self.Fader:In(DragFade)
            Tween(GhostStroke, { Transparency = 1 }, DragFade)
            Tween(GhostText, { TextTransparency = 1 }, DragFade)
            Tween(Ghost, { BackgroundTransparency = 1 }, DragFade, nil, function()
                if Gen == DragGen then Ghost.Visible = false end
            end)
        end
    end
    self.NoteDrag = function() if self.Maximized then self.MovedWhileMax = true end end

    local Grip = Create("TextButton", Main, { Size = UFO(18, 18), Position = UD2(1, -18, 1, -18), ZIndex = 7 })
    for _, D in { { 10, 2 }, { 6, 6 }, { 10, 6 }, { 2, 10 }, { 6, 10 }, { 10, 10 } } do
        Create("Frame", Grip, { Size = UFO(2, 2), Position = UFO(D[1], D[2]), BackgroundColor3 = Theme.Stroke,
            BackgroundTransparency = 0.2, ZIndex = 7 })
    end
    Grip.InputBegan:Connect(function(Input)
        if not IsPress(Input.UserInputType) then return end
        self.Maximized, self.SavedPos, self.MovedWhileMax = false, nil, false
        ApplyIcon(self.MaxIcon, "maximize-2")
        local Start, Size0, Pos0 = Input.Position, Root.Size, Root.Position
        BeginDrag(function(I)
            local Sc = MX(Scale.Scale, 0.01)
            local Want = self:ClampSize(UFO(Size0.X.Offset + (I.Position.X - Start.X) / Sc,
                Size0.Y.Offset + (I.Position.Y - Start.Y) / Sc), Gui.AbsoluteSize, Sc)
            Root.Size, self.DesiredSize = Want, Want
            Root.Position = UD2(Pos0.X.Scale, Pos0.X.Offset + (Want.X.Offset - Size0.X.Offset) * Sc / 2,
                Pos0.Y.Scale, Pos0.Y.Offset + (Want.Y.Offset - Size0.Y.Offset) * Sc / 2)
        end)
    end)
end

