        Why = ("%s only works in %s."):format(Config.HUB_NAME ~= "" and Config.HUB_NAME or "This script",
            Config.GAME_NAME ~= "" and Config.GAME_NAME or "a different game")
            .. (Config.GAME_NOTE ~= "" and (" " .. Config.GAME_NOTE) or "")
    end
    if not Title then return true end

    Private.Allowed = false
    self:Notify({ Title = Title, Content = Why .. " Closing in a few seconds.", Duration = 8 })
