    Create("UIListLayout", Content, { SortOrder = SO.LayoutOrder, FillDirection = FD.Horizontal,
        VerticalAlignment = VFA.Center, Padding = UD(0, L.RailGap) })
    Create("UIPadding", Content, { PaddingTop = UD(0, L.PadY), PaddingBottom = UD(0, L.PadY) })

    local Desc = Props.Description or Props.Content
    local HasDesc = Desc ~= nil and Desc ~= ""
    local Holder = HasDesc and Create("Frame", Content, { BackgroundTransparency = 1, Size = UD2(0, 0, 0, 0),
        AutomaticSize = AS.Y, LayoutOrder = 1 }) or nil
