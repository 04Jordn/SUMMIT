local function Warn(Fmt, ...)
    warn("[SummitX] " .. string.format(Fmt, ...))
end

local function NewScope()
    local Tasks = {}
    local Scope = {}
    function Scope.Add(Item) Tasks[#Tasks + 1] = Item; return Item end
    function Scope.Clean()
        for _ = 1, 8 do
            if #Tasks == 0 then return end
            local List = Tasks
            Tasks = {}
            for I = #List, 1, -1 do
                local Item, Ok, Err = List[I], true, nil
                if typeof(Item) == "RBXScriptConnection" then Ok, Err = pcall(Item.Disconnect, Item)
                elseif typeof(Item) == "Instance" then Ok, Err = pcall(Item.Destroy, Item)
                elseif type(Item) == "function" then Ok, Err = pcall(Item) end
                if not Ok then Warn("a cleanup task errored (the rest still ran): %s", tostring(Err)) end
            end
        end
    end
    return Scope
end

