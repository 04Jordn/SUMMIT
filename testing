        TDL(1.4, function() if GetKey.Parent then GetKey.Text = "Get Key" end end)
    end)

    local Snap = Snapshot(Card)
    ApplySnapshot(Snap, 1)
    ApplySnapshot(Snap, 0, 0.28)
end

