function ActionClass.new(Window, Group, Text, OnFire, Stateful)
    local Gui, Actions = Window.Gui, Window.Actions
    local Holder = Create("Frame", Gui, { Size = UFO(0, 38), AutomaticSize = AS.X,
        Position = UD2(0, 18, 0.34, 0), BackgroundTransparency = 1, ZIndex = 150, Visible = false })
    local Face, FaceStroke = Button(Stateful and "Stateful" or "Action", Holder, { Text = Text, Size = UD2(0, 0, 1, 0),
        AutomaticSize = AS.X, ZIndex = 150 })
    local self = setmetatable({ Group = Group, Holder = Holder, Face = Face, FaceStroke = FaceStroke, Actions = Actions,
        Allowed = true, Moved = false }, ActionClass)
    Actions.List[#Actions.List + 1] = self
    Holder.Destroying:Connect(function()
        self:Free()
        local At = table.find(Actions.List, self)
        if At then TR(Actions.List, At) end
    end)
    DragFree(Face, Holder, Gui, OnFire, function() return Actions.Locked end, function()
        self.Moved = true
        self:Free()
    end)
    self:Draw()
    return self
end

function ActionClass:Free()
    if not self.Slot then return end
    self.Actions.Slots[self.Slot] = nil
    self.Slot = nil
end

function ActionClass:Draw()
    local Actions = self.Actions
    local On = Actions.Shown[self.Group] and self.Allowed
    if not On then self:Free() end
    if On and not (self.Slot or self.Moved) then
        local Slot = 1
        while Actions.Slots[Slot] do Slot += 1 end
        Actions.Slots[Slot], self.Slot = true, Slot
        self.Holder.Position = UD2(0, 18, 0.34, (Slot - 1) * 48)
    end
    self.Holder.Visible = On
end

function ActionClass:SetOn(On, Animated)
    local Face, FaceStroke = self.Face, self.FaceStroke
    local Fc, Tc = On and Theme.ToggleActive or Theme.Section, On and Theme.Text or Theme.SubText
    local Sc, St = On and Theme.Active or Theme.Stroke, On and 0.2 or 0.55
    if Animated then
        Tween(Face, { BackgroundColor3 = Fc, TextColor3 = Tc }, 0.2)
        Tween(FaceStroke, { Color = Sc, Transparency = St })
        return
    end
    CancelMotors(Face); CancelMotors(FaceStroke)
    Face.BackgroundColor3, Face.TextColor3, FaceStroke.Color, FaceStroke.Transparency = Fc, Tc, Sc, St
end

function ActionClass:SetAllowed(Ok)
    Ok = not not Ok
    if self.Allowed == Ok then return end
    self.Allowed = Ok
    self:Draw()
end

function ActionClass:Destroy() self.Holder:Destroy() end

local function ShowActions(Window, Group, On)
    local A = Window.Actions
    A.Shown[Group] = not not On
    for _, Entry in A.List do
        if Entry.Group == Group then Entry:Draw() end
    end
end

