--!mv:vm
function Library:SetPremium(Value, State)
    Value = not not Value
    local Changed = Value ~= Private.Premium
    Private.Premium = Value
    self.IsPremium, self.PremiumState = Value, State or (Value and "premium" or "free")
    for Overlay in PremiumGates do
        Overlay.Visible = not Value
        Overlay.Active = not Value
    end
