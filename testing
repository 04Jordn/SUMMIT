local WindowClass = {}
WindowClass.__index = WindowClass


local function LauncherAsset()
    if not (Env.CustomAsset and Env.CanSave) then return nil end
    local File = Private.Folder .. "/launcher_v1.png"
    if not Env.ReadFile(File) then
        local Data = Env.HttpGet("https://raw.githubusercontent.com/04Jordn/SUMMIT/main/SX%20Icon.png")
        if type(Data) ~= "string" or Data:sub(2, 4) ~= "PNG" then return nil end
        if not Env.WriteFile(File, Data) then return nil end
    end
    local Ok, Id = pcall(Env.CustomAsset, File)
    return Ok and type(Id) == "string" and Id or nil
end

function Library:CreateWindow(Opts)
    if type(Opts) ~= "table" then Opts = { Title = Opts } end
    if self.Window then self.Window:Destroy() end
    if Opts.Mobile ~= nil then SetMobile(Opts.Mobile) end
    if type(Opts.Folder) == "string" and Opts.Folder ~= "" then Private.Folder = Opts.Folder end
    Private.Title = tostring(Opts.Title or "SummitX")
    Private.RestoreTheme()

    local ConfigPath = Opts.ConfigFile
    if ConfigPath == nil and Opts.Config ~= false then
        ConfigPath = ("%s/configs/%s.json"):format(Private.Folder, tostring(Opts.Config or game.GameId))
    end

    local Window = setmetatable({
        Title = Private.Title, Scope = NewScope(), Store = StoreClass.new(ConfigPath or nil),
        Tabs = {}, TabsByName = {}, Warm = {}, Popup = nil, Drop = nil, Active = nil,
        Actions = { Slots = {}, List = {}, Shown = { Toggle = false, Action = false }, Locked = false },
        Open = true, LauncherOn = IsMobile, Maximized = false, MovedWhileMax = false,
    }, WindowClass)
    self.Window = Window
    Lifetime.Add(Window.Scope.Clean)
    Window.Scope.Add(function() Surface.Close() end)
    Window.Scope.Add(function() if Window.WarmConn then Window.WarmConn:Disconnect(); Window.WarmConn = nil end end)

    Window:BuildFrame(Opts)
    Window:BuildTopbar(Opts)
    Window:BuildSidebar()
    Window:BuildLauncher()
    Window:WatchViewport()
    if not IsMobile then
        Window.MenuBind = BindClass.new(Opts.Keybind or "RightShift", function() Window:Toggle() end, false)
        Window.Scope.Add(function() Window.MenuBind:Drop() end)
    end

    TDF(function()
        local Root, Gui = Window.Root, Window.Gui
        if Root.Parent or not Gui.Parent then return end
        Root.Parent = Gui
        Window.QueueRefit()
        for _ = 1, 4 do
            if Gui.AbsoluteSize.X >= 64 and Root.AbsoluteSize.X > 0 then break end
            RunService.Heartbeat:Wait()
        end
        if not (Root.Parent and Gui.Parent) then return end
        Window:Refit()
        Root.Visible = true
    end)
    SetCursor(true)
    Window.Scope.Add(function() SetCursor(false) end)
    return Window
end

function WindowClass:BuildFrame(Opts)
    local Scope = self.Scope
    local Gui = Mount(9999, Scope)
    local W, H = IsMobile and 560 or 880, IsMobile and 330 or 520
    self.SidebarW = IsMobile and 150 or 170
    self.DesiredSize = UFO(W, H)

