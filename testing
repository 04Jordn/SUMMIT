local DropView, Render, Refilter
local DropMax, SearchH, DropRow, DropGap = 224, 36, 32, 4
local DropStep = DropRow + DropGap
do
local DropSlots = math.ceil((DropMax - SearchH - 12) / DropStep) + 2
local Floor = math.floor

local function Slot(View, Si)
    local B = Create("TextButton", View.List, { Size = UD2(1, 0, 0, DropRow),
        BackgroundColor3 = Theme.DropdownOption, BackgroundTransparency = 0.15, TextSize = 13, TextColor3 = Theme.SubText,
        TextXAlignment = TXA.Left, TextTruncate = ETT.AtEnd, ZIndex = 202 })
    Decorate(B, L.Corner6, nil, { nil, nil, 14, 8 })
    local Bar = Create("Frame", B, { Size = UD2(0, 3, 0, 0), Position = UD2(0, -9, 0.5, 0),
        AnchorPoint = V2(0, 0.5), BackgroundColor3 = Theme.Accent, ZIndex = 203 })
    Decorate(Bar, L.Pill)
    Interactive(B, {
        Over = { BackgroundTransparency = 0, TextColor3 = Theme.Text },
        Out = function()
            local O, Idx = Surface.Owner, View.Map[Si]
            local Sel = O ~= nil and Idx ~= nil and O.IsSel(Idx)
            return { BackgroundTransparency = Sel and 0 or 0.15, TextColor3 = Sel and Theme.Active or Theme.SubText }
        end,
        Time = 0.15,
    })
    B.MouseButton1Click:Connect(function()
        local O, Idx = Surface.Owner, View.Map[Si]
        if O and Idx then O.Pick(Idx) end
    end)
    View.Slots[Si], View.Bars[Si] = B, Bar
    return B
end

--!mv:omit
function Render(View)
    local O = Surface.Owner
    if not (O and O.Kind == "Dropdown") then return end
    local List, Scroller = View.Filtered, View.List
    local N = #List
    local First = MC(Floor(Scroller.CanvasPosition.Y / (DropStep * MX(Surface.Window.Scale.Scale, 0.01))) + 1, 1, MX(1, N - DropSlots + 1))
    for Si = 1, DropSlots do
        local Idx = First + Si - 1
        local B = View.Slots[Si]
        if Idx > N then
            if B then B.Visible = false end
            View.Map[Si] = nil
            continue
        end
        B = B or Slot(View, Si)
        local Opt = List[Idx]
        local Sel = O.IsSel(Opt)
        View.Map[Si] = Opt
        B.Text = O.TextAt(Opt)
        B.Position = UFO(0, (Idx - 1) * DropStep)
        B.BackgroundTransparency = Sel and 0 or 0.15
        B.TextColor3 = Sel and Theme.Active or Theme.SubText
        View.Bars[Si].Size = UD2(0, 3, 0, Sel and 15 or 0)
        B.Visible = true
    end
    Scroller.CanvasSize = UD2(0, 0, 0, N * DropStep)
end

function Refilter(View, Options)
    local Q = View.Search.Text:lower():match("^%s*(.-)%s*$")
    TCL(View.Filtered)
    for I, Opt in Options do
        if Q == "" or Opt:lower():find(Q, 1, true) then View.Filtered[#View.Filtered + 1] = I end
    end
    View.List.CanvasPosition = Vector2.zero
    Render(View)
end

function DropView(Panel)
    local Frame = Create("Frame", Panel, { Size = UFS(1, 1), BackgroundTransparency = 1, ZIndex = 200 })
    local Search = Create("TextBox", Frame, { PlaceholderText = "Search...", Size = UD2(1, -16, 0, 28), Position = UFO(8, 6),
        BackgroundColor3 = Theme.BindBackground, BackgroundTransparency = 0.35, PlaceholderColor3 = Theme.Placeholder, TextSize = 12, ZIndex = 201 })
    Decorate(Search, L.Corner6, { Theme.Stroke, 0.7, 1 }, { nil, nil, 10, 10 })
    local Scroller = Create("ScrollingFrame", Frame, { Size = UD2(1, -8, 1, -(12 + SearchH)), Position = UFO(4, 6 + SearchH),
        BackgroundTransparency = 1, ZIndex = 201, AutomaticCanvasSize = AS.None })
    Create("UIPadding", Scroller, { PaddingLeft = UD(0, 4), PaddingRight = UD(0, 6) })
    local View = { Frame = Frame, Search = Search, List = Scroller, Slots = {}, Bars = {}, Map = {}, Filtered = {} }
    Search:GetPropertyChangedSignal("Text"):Connect(function()
        local O = Surface.Owner
        if not (O and O.Kind == "Dropdown") then return end
        O.Filter()
        Surface.Place()
    end)
    Scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(function() Render(View) end)
    return View
end
end

DefineControl("Dropdown", function(Ctx, Props, Host)
    Expect(Props, "Name")
    local Window, Row = Ctx.Window, Host.Instance
    local Multi = Props.Multi
    local Chosen, Options = {}, {}
    local Default = Props.Default
    if Default == nil and not Multi and Props.Options then Default = Props.Options[1] end
    if type(Default) == "table" then
        for _, V in Default do Chosen[tostring(V)] = true end
    elseif Default ~= nil then
        Chosen[tostring(Default)] = true
    end

    local Opener = Create("TextButton", Host.Rail(), { Size = UFO(164, 22), LayoutOrder = 50 })
    local Header = RowHit(Row)
    local ValLbl = Create("TextLabel", Opener, { Size = UD2(1, -20, 1, 0), TextColor3 = Theme.SubText,
        TextXAlignment = TXA.Right, TextTruncate = ETT.AtEnd })
    local Chev = Create("ImageLabel", Opener, { Size = UFO(14, 14), AnchorPoint = V2(1, 0.5),
        Position = UD2(1, 0, 0.5, 0), ImageColor3 = Theme.SubText })
    ApplyIcon(Chev, "chevron-down")

    local Me, View, Changed = { Kind = "Dropdown", Clip = Ctx.Page, Content = Host.Content }, nil, nil

    local function Values()
        local Out, Seen = {}, {}
        for _, Opt in Options do
            if Chosen[Opt] then Out[#Out + 1] = Opt; Seen[Opt] = true end
        end
        local Tail = {}
        for K in Chosen do
            if not Seen[K] then Tail[#Tail + 1] = K end
        end
        table.sort(Tail)
        table.move(Tail, 1, #Tail, #Out + 1, Out)
        return Out
    end
    local function Get()
        local Vals = Values()
        return Multi and Vals or (Vals[1] or "")
    end
    local function Display()
        local Vals = Values()
        ValLbl.Text = #Vals > 0 and table.concat(Vals, ", ") or "None"
        if Surface.IsOpen(Me) then Render(View) end
    end

    local function Refresh()
        local Src = Props.Populate and Props.Populate() or Props.Options or {}
        TCL(Options)
        for I, V in Src do Options[I] = tostring(V) end
        Display()
        if not Surface.IsOpen(Me) then return end
        Refilter(View, Options)
        Surface.Place()
    end
    Refresh()

    local function Select(Opt)
        local K = tostring(Opt)
        if Multi then Chosen[K] = (not Chosen[K]) or nil else TCL(Chosen); Chosen[K] = true end
        Display()
        if not Multi then Surface.Close(Me) end
        Changed(Get())
    end

    local function SetValue(V)
        TCL(Chosen)
        if type(V) == "table" then
            for _, X in V do Chosen[tostring(X)] = true end
        elseif V ~= nil and V ~= "" then
            Chosen[tostring(V)] = true
        end
        Display()
        Changed(Get())
    end

    function Me.Height() return MC(#View.Filtered * DropStep + 14 + SearchH, 44 + SearchH, DropMax) end
    function Me.OnClose() Tween(Chev, { Rotation = 0 }, 0.18) end
    function Me.IsSel(I) return Chosen[Options[I]] == true end
    function Me.TextAt(I) return Options[I] or "" end
    function Me.Pick(I) if Options[I] then Select(Options[I]) end end
    function Me.Filter() Refilter(View, Options) end

    local function Open()
        if Surface.IsOpen(Me) then Surface.Close(Me); return end
        Surface.Mount(Window)
        View = Surface.View("Dropdown", DropView)
        Surface.Open(Window, Me, Row)
        View.Search.Text = ""
        Refresh()
        Tween(Chev, { Rotation = 180 }, 0.18)
    end

    local H
    H, Changed = Bind(Ctx, Props, FlagFor(Ctx, Props), Get, SetValue)
    H.Instance = Opener
    function H.Refresh() Refresh() end
    function H.SetOptions(List) Props.Options = TC(List); Refresh() end

    Row.Destroying:Connect(function() Surface.Close(Me) end)
    Opener.MouseButton1Click:Connect(Open)
    Header.MouseButton1Click:Connect(Open)
    return H
end)

