local Binds, Pending = {}, nil

local KeyShort = {
    LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
    LeftAlt = "LAlt", RightAlt = "RAlt", LeftSuper = "LWin", RightSuper = "RWin",
    Backspace = "Bksp", CapsLock = "Caps", PageUp = "PgUp", PageDown = "PgDn", Delete = "Del",
    Insert = "Ins", Escape = "Esc", Return = "Enter", KeypadEnter = "NumEnter", PrintScreen = "PrtSc",
}

local BindClass = {}
BindClass.__index = BindClass

function BindClass.new(Key, Action, CanHold)
    local self = setmetatable({ Key = Key or "NONE", Mode = "Toggle", Action = Action, CanHold = CanHold }, BindClass)
    Binds[self] = true
    return self
end

function BindClass:Drop()
    Binds[self] = nil
    if Pending == self then Pending = nil end
end

function BindClass:Render()
    if not self.Pill then return end
    self.Pill.Text = (KeyShort[self.Key] or self.Key) .. (self.Mode == "Hold" and "  HOLD" or "")
end

function BindClass:Load(Value)
    Value = tostring(Value)
    local Key, Mode = Value:match("^(.-)|(.+)$")
    self.Key = Key or Value
    self.Mode = (Mode == "hold" and self.CanHold) and "Hold" or "Toggle"
    self:Render()
end

function BindClass:Save() return self.Mode == "Hold" and (self.Key .. "|hold") or self.Key end

function BindClass:Arm()
    if Pending and Pending ~= self then Pending:Disarm() end
    Pending = self
    self.Pill.Text = "..."
    Tween(self.Pill, { TextColor3 = Theme.Accent, BackgroundColor3 = Theme.Section })
end

function BindClass:Disarm()
    self:Render()
    if self.Pill then Tween(self.Pill, { TextColor3 = Theme.SubText, BackgroundColor3 = Theme.BindBackground }) end
end

function BindClass:Capture(Key)
    self.Key = Key
    self:Disarm()
    if self.Store then self.Store:MarkDirty(self.Flag) end
end

function BindClass:Press()
    if self.Mode == "Hold" then self.Action(true) else self.Action() end
end

function BindClass:Release()
    if self.Mode == "Hold" then self.Action(false) end
end

function BindClass:Mount(Parent, Flag, Store)
    local Pill = Create("TextButton", Parent, { AutomaticSize = AS.X,
        Size = UD2(0, 0, 0, 22), LayoutOrder = 5, BackgroundColor3 = Theme.BindBackground, BackgroundTransparency = 0.5,
        TextColor3 = Theme.SubText, TextSize = 10 })
    Decorate(Pill, L.Corner6, { Theme.Stroke, 0.7, 1 }, { nil, nil, 10, 10 })
    Create("UISizeConstraint", Pill, { MinSize = V2(44, 22) })
    Interactive(Pill, { Over = { BackgroundTransparency = 0.2 }, Out = { BackgroundTransparency = 0.5 }, Time = 0.15 })
    self.Pill, self.Flag, self.Store = Pill, Flag, Store
    self:Render()

    local Slot = { Get = function() return self:Save() end, Set = function(Value) self:Load(Value) end }
    Store:Register(Flag, Slot)
    Pill.Destroying:Connect(function()
        if Pending == self then Pending = nil end
        Store:Unregister(Flag, Slot)
    end)
    Pill.MouseButton1Click:Connect(function() self:Arm() end)
    if self.CanHold then
        Pill.MouseButton2Click:Connect(function()
            self.Mode = self.Mode == "Hold" and "Toggle" or "Hold"
            self:Render()
            Store:MarkDirty(Flag)
        end)
    end
    return Pill, Slot
end

