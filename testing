        Callback = function(On)
            self:SetLauncher(On)
            if IsMobile and not On then
                Library:Notify({ Title = "Launcher hidden", Duration = 8,
                    Content = "Once you close this menu there is no way to reopen it — run the script again to get it back." })
            end
        end })
