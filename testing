            TextXAlignment = TXA.Left, TextWrapped = true, Size = UD2(1, 0, 0, 0),
            AutomaticSize = AS.Y, LayoutOrder = 2 })
    end

    local RailFrame
    local function Rail()
        if not RailFrame then
            RailFrame = Create("Frame", Content, { BackgroundTransparency = 1, Size = UD2(0, 0, 0, 0),
                AutomaticSize = AS.XY, LayoutOrder = 2 })
            ListLayout(RailFrame, L.RailGap, true, HFA.Right)
