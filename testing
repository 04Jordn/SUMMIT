function Library:Allowed()
    if Private.Allowed ~= nil then return Private.Allowed end
    if game.GameId == 0 then return true end
    Private.Allowed = true

    local Title, Why
    local Executor = Env.Executor:lower()
    for _, Entry in Config.UNSUPPORTED or {} do
        if type(Entry) == "string" and Entry ~= "" and Executor:find(Entry:lower(), 1, true) then
            Title = "Executor not supported"
            Why = ("%s doesn't run on %s."):format(Config.HUB_NAME, Env.Executor)
