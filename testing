function WindowClass:WatchViewport()
    local Gui, Conn, UntilT, Last = self.Gui, nil, 0, self.Gui.AbsoluteSize
    local function Watch()
        if not Gui.Parent or OC() > UntilT then Conn:Disconnect(); Conn = nil; return end
        local Vp = Gui.AbsoluteSize
        if Vp ~= Last then Last = Vp; self:Refit() end
    end
    local function Queue()
        UntilT = OC() + 0.5
        if not Conn then Conn = RunService.Heartbeat:Connect(Watch) end
    end
    self.QueueRefit = Queue
    self.Scope.Add(Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(Queue))
    local Cam = workspace.CurrentCamera
    if Cam then self.Scope.Add(Cam:GetPropertyChangedSignal("ViewportSize"):Connect(Queue)) end
    self.Scope.Add(function() if Conn then Conn:Disconnect(); Conn = nil end end)
    Queue()
end

-------------------------------------------------------------------------- window state

function WindowClass:ClampSize(Size, Vp, Sc)
    local MaxW, MaxH = MX(160, Vp.X / Sc), MX(160, Vp.Y / Sc)
    return UFO(MC(Size.X.Offset, MM(L.MinW, MaxW), MaxW), MC(Size.Y.Offset, MM(L.MinH, MaxH), MaxH))
end

function WindowClass:Refit()
    local Root, Gui = self.Root, self.Gui
    if not Root.Parent then return end
    local Vp, Sc = Gui.AbsoluteSize, MX(self.Scale.Scale, 0.01)
    if Vp.X < 64 or Vp.Y < 64 then
        local Cam = workspace.CurrentCamera
        Vp = Cam and Cam.ViewportSize or Vp
    end
    if Vp.X < 64 or Vp.Y < 64 then return end
    if self.Maximized then
        CancelMotors(Root)
        Root.Size = UFO((Vp.X - 20) / Sc, (Vp.Y - 20) / Sc)
        Root.Position = UFS(0.5, 0.5)
        return
    end
    local Want = self:ClampSize(self.DesiredSize, Vp, Sc)
    if Want ~= Root.Size then CancelMotors(Root); Root.Size = Want end
    local W = Root.AbsoluteSize.X
    local Tl = Root.AbsolutePosition - Gui.AbsolutePosition
    local Nx = MC(Tl.X, 100 - W, MX(100 - W, Vp.X - 100))
    local Ny = MC(Tl.Y, 0, MX(0, Vp.Y - 44))
    if Nx ~= Tl.X or Ny ~= Tl.Y then SetTopLeft(Root, Vp, Nx, Ny) end
end

function WindowClass:SetMaximized(On)
    On = not not On
    if On == self.Maximized then return end
    self.Maximized = On
    local Root, Vp, Sc = self.Root, self.Gui.AbsoluteSize, MX(self.Scale.Scale, 0.01)
    if On then
        self.SavedPos = Root.Position
        Tween(Root, { Size = UFO((Vp.X - 20) / Sc, (Vp.Y - 20) / Sc), Position = UFS(0.5, 0.5) }, 0.3)
    else
        Tween(Root, { Size = self:ClampSize(self.DesiredSize, Vp, Sc),
            Position = self.MovedWhileMax and Root.Position or self.SavedPos or UFS(0.5, 0.5) }, 0.3)
    end
    self.MovedWhileMax = false
    ApplyIcon(self.MaxIcon, On and "minimize-2" or "maximize-2")
end

function WindowClass:SetScale(Value)
    self.Scale.Scale = (tonumber(Value) or 1) * L.ScaleBase
    self:Refit()
end

function WindowClass:RefreshLauncher()
    local Fab, Wanted = self.Fab, self.LauncherOn and not self.Open
    if Wanted then
        Fab.Visible = true
        Tween(self.FabScale, { Scale = 1 }, 0.32, 0.62)
    else
        Tween(self.FabScale, { Scale = 0 }, 0.18, 1, function()
            if not (self.LauncherOn and not self.Open) then Fab.Visible = false end
        end)
    end
end

function WindowClass:SetLauncher(On)
    self.LauncherOn = not not On
    self:RefreshLauncher()
end

function WindowClass:SetOpen(Open)
    Open = not not Open
    if Open == self.Open then return end
    self.Open = Open
    if not Open then Surface.Close() end
    SetCursor(Open)
    self.Fader:Show(Open)
    self:RefreshLauncher()
end

function WindowClass:IsOpen() return self.Open end
function WindowClass:Toggle() self:SetOpen(not self.Open) end

function WindowClass:SetProfileVisible(On)
    self.Profile.Visible = On
    self.ProfileDivider.Visible = On
end

function WindowClass:Notify(Cfg) return Library:Notify(Cfg) end

function WindowClass:Destroy()
    self.Scope.Clean()
    if Library.Window == self then Library.Window = nil end
end

-------------------------------------------------------------------------- tabs

function WindowClass:AddTab(Opts, Subtitle, Icon)
    if type(Opts) ~= "table" then Opts = { Name = Opts, Subtitle = Subtitle, Icon = Icon } end
    local Name = tostring(Opts.Name or ("Tab " .. (#self.Tabs + 1)))
    local Index = #self.Tabs + 1

    local Btn = Create("TextButton", self.TabList, { Size = UD2(1, -24, 0, L.TabH), BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1, ZIndex = 3, LayoutOrder = Index })
    Decorate(Btn, L.Corner8)
    local Img = Create("ImageLabel", Btn, { Size = UFO(17, 17), Position = UD2(0, 16, 0.5, -8), ImageColor3 = Theme.TabText, ZIndex = 4 })
    ApplyIcon(Img, Opts.Icon or TabIcons[Name] or "circle")
    local Lbl = Create("TextLabel", Btn, { Text = Name, Size = UD2(1, -48, 1, 0), Position = UD2(0, 40, 0, 0), TextColor3 = Theme.TabText,
        TextSize = L.TitleSize, TextXAlignment = TXA.Left, TextTruncate = ETT.AtEnd, ZIndex = 4 })

    local Page = Stack("Page", self.PageHost, self.Scale, { Size = UFS(1, 1), BackgroundTransparency = 1, Visible = false,
        AutomaticCanvasSize = AS.None }, 12, { 4, 8, 12, 12 }, HFA.Center)

    local Tab = NewContainer(self, Page, Name, Page)
    Tab.Name, Tab.Subtitle, Tab.Index, Tab.Button = Name, Opts.Subtitle or "", Index, Btn
    Tab.SelY = (Index - 1) * (L.TabH + L.TabGap) + L.TabH / 2
    function Tab.Select() self:SelectTab(Tab) end
    function Tab.SetActive(On, Instant)
        Page.Visible = On
        local Props = { BackgroundTransparency = On and 0.85 or 1 }
        local Text, Icon = { TextColor3 = On and Theme.Text or Theme.TabText }, { ImageColor3 = On and Theme.Accent or Theme.TabText }
        if Instant then
            Btn.BackgroundTransparency, Lbl.TextColor3, Img.ImageColor3 = Props.BackgroundTransparency, Text.TextColor3, Icon.ImageColor3
        else
            Tween(Btn, Props, 0.18); Tween(Lbl, Text, 0.18); Tween(Img, Icon, 0.18)
        end
    end
    self.Tabs[Index], self.TabsByName[Name] = Tab, Tab

    Btn.MouseButton1Click:Connect(Tab.Select)
    Interactive(Btn, { Over = { BackgroundTransparency = 0.93 }, Out = { BackgroundTransparency = 1 }, Time = 0.15,
        Enabled = function() return not Page.Visible end })

    Tab.Pending = Opts.Build
    if not self.Active then
        self.Active = Tab
        Tab.SetActive(true, true)
        self.HeadTitle.Text, self.HeadSub.Text = Name, Tab.Subtitle
        self.Selector.Position, self.Selector.Size = UD2(0, 6, 0, Tab.SelY), UD2(0, 3, 0, 20)
        self:BuildPending(Tab)
    elseif Tab.Pending then
        self:QueueWarm(Tab)
    end
    return Tab
end

function WindowClass:GetTab(Which)
    if type(Which) == "table" then return Which end
    return self.TabsByName[Which] or self.Tabs[Which]
end

function WindowClass:SelectTab(Which)
    local Tab = self:GetTab(Which)
    if not Tab or Tab == self.Active then return Tab end
    self:BuildPending(Tab)
    Surface.Close()
    if self.Active then self.Active.SetActive(false) end
    self.Active = Tab
    Tab.SetActive(true)
    self.HeadTitle.Text, self.HeadSub.Text = Tab.Name, Tab.Subtitle
    Tween(self.Selector, { Position = UD2(0, 6, 0, Tab.SelY) }, 0.28)
    return Tab
end

function WindowClass:BuildPending(Tab)
    local Build = Tab.Pending
    if not Build then return end
    Tab.Pending = nil
    local Ok, Err = xpcall(Build, debug.traceback, Tab, self)
    if not Ok then Warn("tab %q failed to build:\n%s", Tab.Name, tostring(Err)) end
end

function WindowClass:QueueWarm(Tab)
    local Queue = self.Warm
    Queue[#Queue + 1] = Tab
    if self.WarmConn then return end
    self.WarmConn = RunService.Heartbeat:Connect(function()
        local Next = TR(Queue, 1)
        while Next and not Next.Pending do Next = TR(Queue, 1) end
        if Next then self:BuildPending(Next) end
        if #Queue == 0 then self.WarmConn:Disconnect(); self.WarmConn = nil end
    end)
end

