            OnPass()
            Library:Notify({ Title = "You're in", Duration = 4, Content = ViaPremium and "Premium — no key needed."
                or ("Key accepted — loading " .. (Config.HUB_NAME ~= "" and Config.HUB_NAME or "the script") .. ".") })
        end)
    end
    DropPremium = Library:OnPremiumChanged(function(IsPremium) if IsPremium then Pass(true) end end)

    local function Submit()
        if Granted or Busy then return end
        Busy = true
        SubmitButton.Text = "Checking..."
        TSP(function()
            local Ok, Offline = Check(Box.Text)
            Busy = false
            if Granted or not IsCurrent() then return end
            SubmitButton.Text = "Submit"
