        LoopEntry = Library:RegisterLoop(Props.Loop.Type or "PreRender", Props.Loop.Func, Gated, Props.Loop.Interval)
        LoopEntry.Active = State
    end

    local ActionBtn
    local function Shown() return State and not Locked(Props) end
    local Repaint = RowPaint(Window.Fader, Host.Instance, Host.Stroke, Host.NameLabel, Tick)
    local function ApplyVisual(Animated)
        local On = Shown()
        Repaint(On, Animated)
        if ActionBtn then
            ActionBtn:SetAllowed(not Locked(Props))
            ActionBtn:SetOn(On, Animated)
        end
    end

    local Changed
    local function SetState(V)
        V = not not V
        if State == V then return end
        State = V
        if LoopEntry then LoopEntry.Active = State end
        ApplyVisual(true)
        Changed(State)
    end

    local H
    H, Changed = Bind(Ctx, Props, Flag, function() return State end, SetState, LoopEntry)
    H.Instance = Ring

    if Props.Keybind ~= nil and not IsMobile then
        local Entry = BindClass.new(Props.Keybind, function(Down)
            if Down == nil then SetState(not State) else SetState(Down) end
        end, true)
        Entry:Mount(Host.Rail(), Flag and (Flag .. "_bind") or nil, Window.Store)
        H.AddTeardown(function() Entry:Drop() end)
    elseif Props.Keybind ~= nil then
        ActionBtn = ActionClass.new(Window, "Toggle", Props.Name, function()
            if Locked(Props) then PremiumNag(); return end
            SetState(not State)
        end, true)
        H.AddTeardown(function() ActionBtn:Destroy() end)
    end

    ApplyVisual(false)
    if Shown() then Spawn(Props.Callback, State) end
    if Props.Premium then
        H.AddTeardown(Library:OnPremiumChanged(function(On)
            ApplyVisual(true)
            if On and State then Spawn(Props.Callback, State) end
        end))
    end
    Hit.MouseButton1Click:Connect(function() SetState(not State) end)
    return H
end)

