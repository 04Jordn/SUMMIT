local function RowHit(Frame)
    local Hit = Create("TextButton", Frame, { Size = UFS(1, 1), ZIndex = 0 })
    Interactive(Hit, { Target = Frame, Over = { BackgroundTransparency = 0.02 }, Out = { BackgroundTransparency = 0.15 }, Time = 0.12 })
    return Hit
end

local function RowPaint(Fader, Frame, Stroke, NameLbl, Tick)
    return function(On, Animated)
        local St, Tt = On and 0.2 or 0.55, On and 0 or 1
        local Fc = On and Theme.ToggleActive or Theme.Section
        local Sc = On and Theme.Active or Theme.Stroke
        local Tc = On and Theme.Text or Theme.SubText
        if Animated and Fader:Alpha() == 0 then
            Tween(Tick, { ImageTransparency = Tt }, 0.15)
            Tween(Frame, { BackgroundColor3 = Fc })
            Tween(Stroke, { Color = Sc, Transparency = St })
            Tween(NameLbl, { TextColor3 = Tc }, 0.2)
        else
            CancelMotors(Frame, "BackgroundColor3"); CancelMotors(Stroke, "Color"); CancelMotors(NameLbl, "TextColor3")
            Frame.BackgroundColor3, NameLbl.TextColor3, Stroke.Color = Fc, Tc, Sc
            Fader:SetRest(Stroke, "Transparency", St)
            Fader:SetRest(Tick, "ImageTransparency", Tt)
        end
    end
end

local function Bind(Ctx, Props, Flag, Getter, Setter, LoopEntry)
    local Store = Ctx.Window.Store
    local H = { Flag = Flag, Get = Getter, Set = Setter, OnChanged = AddObserver }
    local Slot = { Get = Getter, Set = Setter }
    Store:Register(Flag, Slot)

    local Torn, Extras = false, {}
    function H.AddTeardown(Fn) Extras[#Extras + 1] = Fn end
    function H.Teardown()
        if Torn then return end
        Torn = true
        Store:Unregister(Flag, Slot)
        if LoopEntry then Library:RemoveLoop(LoopEntry) end
        for _, Fn in Extras do Fn() end
    end

    return H, function(Value)
        Store:MarkDirty(Flag)
        if Props.Callback and not Locked(Props) then TSP(Props.Callback, CloneValue(Value)) end
        FireObservers(H, Value)
    end
end

local function WireTeardown(H)
    if type(H) == "table" and H.Teardown and H.Instance then H.Instance.Destroying:Connect(H.Teardown) end
    return H
end

local function DefineWidget(Kind, Build)
    Container["Add" .. Kind] = function(self, Props)
        if type(Props) == "table" then Props = TC(Props) end
        return WireTeardown(Build(self, Props or {}))
    end
end

local function DefineControl(Kind, Build)
    Container["Add" .. Kind] = function(self, Props)
        Props = TC(Props or {})
        local Frame, Stroke, NameLbl, Rail, Content = MakeRow(self.Parent, Props, Props.Active)
        Gate(Frame, Props)
        local H = WireTeardown(Build(self, Props, { Instance = Frame, Stroke = Stroke, NameLabel = NameLbl, Rail = Rail, Content = Content }))
        if type(H) == "table" then H.Row = Frame elseif H == nil then Frame:Destroy() end
        return H
    end
end

