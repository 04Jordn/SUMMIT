DefineControl("Slider", function(Ctx, Props, Host)
    Expect(Props, "Name")
    local Min, Max = Props.Min or 0, Props.Max or 100
    if Max < Min then error(("SummitX: %s: Max (%s) is below Min (%s)"):format(tostring(Props.Name), tostring(Max), tostring(Min)), 3) end
    local Span = Max - Min
    if Span == 0 then Span = 1 end
    local Decimals = MC(Props.Int and 0 or Props.Decimals or 0, 0, 6)
    local Fmt, Mult = "%." .. Decimals .. "f", 10 ^ Decimals
    local function Round(V) return MR(MC(V, Min, Max) * Mult) / Mult end

    local Default = Round(Props.Default or Min)
    local RailFrame = Host.Rail()
    local ValText = Create("TextBox", RailFrame, { Text = Fmt:format(Default), Size = UFO(58, 18), LayoutOrder = 39,
        TextColor3 = Theme.Accent, TextSize = L.TitleSize,
        TextXAlignment = TXA.Right, ClearTextOnFocus = true })
    local Track = Create("Frame", RailFrame, { Size = UFO(150, 6), LayoutOrder = 40, BackgroundColor3 = Theme.SliderTrack })
    Decorate(Track, L.Corner6)
    local Fill = Create("Frame", Track, { Size = UD2((Default - Min) / Span, 0, 1, 0), BackgroundColor3 = Theme.Accent })
    Decorate(Fill, L.Corner6)
    local GrabSize = 12
    local function GrabPos(Frac) return UD2(Frac, (0.5 - Frac) * GrabSize, 0.5, 0) end
    local Grab = Create("Frame", Track, { Size = UFO(GrabSize, GrabSize), AnchorPoint = V2(0.5, 0.5),
        Position = GrabPos((Default - Min) / Span), BackgroundColor3 = ColorWhite, ZIndex = 2 })
    Decorate(Grab, L.Pill, { Theme.Accent, 0.4, 1.5 })

    local Current, Changed = Default, nil
    local function Apply(V, Instant)
        V = Round(V)
        if Instant and V == Current then return end
        Current = V
        ValText.Text = Fmt:format(V)
        local Frac = (V - Min) / Span
        local Size, Pos = UD2(Frac, 0, 1, 0), GrabPos(Frac)
        if Instant then
            CancelMotors(Fill); CancelMotors(Grab)
            Fill.Size, Grab.Position = Size, Pos
        else
            Tween(Fill, { Size = Size }, 0.1)
            Tween(Grab, { Position = Pos }, 0.1)
        end
        Changed(V)
    end

    local H
    H, Changed = Bind(Ctx, Props, FlagFor(Ctx, Props), function() return Current end, function(V) Apply(tonumber(V) or Current) end)
    H.Instance = Track

    ValText.Focused:Connect(function() Tween(ValText, { TextColor3 = Theme.Text }, 0.15) end)
    ValText.FocusLost:Connect(function()
        Tween(ValText, { TextColor3 = Theme.Accent }, 0.15)
        local Num = tonumber((ValText.Text:gsub(",", ".")))
        if Num then Apply(Num) else ValText.Text = Fmt:format(Current) end
    end)

    BindSlider(Track, Ctx.Page, function(Alpha) Apply(Min + Alpha.X * Span, true) end)
    return H
end)

