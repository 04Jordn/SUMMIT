        local BarClip = Create("Frame", Card, { Size = UD2(1, 0, 0, 2), BackgroundTransparency = 1, ClipsDescendants = true })
        local Bar = Create("Frame", BarClip, { Size = UD2(1, 0, 0, BarBody), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.35 })
        Decorate(Bar, L.Corner8)

        local Body = Create("Frame", Card, { Position = UFO(22, 0), Size = UD2(1, -54, 0, 0),
            AutomaticSize = AS.Y, BackgroundTransparency = 1 })
        ListLayout(Body, 3)
        Create("UIPadding", Body, { PaddingTop = UD(0, 14), PaddingBottom = UD(0, 14) })
        Create("TextLabel", Body, { Text = Cfg.Title or Private.Title or "SummitX", Size = UD2(1, 0, 0, 15), TextColor3 = Theme.Text,
            TextSize = 13, TextXAlignment = TXA.Left,
            TextTruncate = ETT.AtEnd, LayoutOrder = 1 })
        local Content
        if Cfg.Content and Cfg.Content ~= "" then
            Content = Create("TextLabel", Body, { Text = Cfg.Content, Size = UD2(1, 0, 0, 0), AutomaticSize = AS.Y,
                TextColor3 = Theme.SubText, TextSize = 12, TextWrapped = true, TextXAlignment = TXA.Left, LayoutOrder = 2 })
        end

        local Entry, Closed, CardSnap, StopReveal, BarTween = { Instance = Holder }, false, nil, nil, nil
        function Entry.Close()
            if Closed then return end
            Closed = true
            if StopReveal then StopReveal() end
            if BarTween then BarTween:Cancel() end
            local At = table.find(Live, Entry)
            if At then TR(Live, At) end
            Holder.Size = UD2(1, 0, 0, Holder.AbsoluteSize.Y)
            Holder.AutomaticSize = AS.None
            ApplySnapshot(CardSnap, 1, 0.22)
            Tween(Card, { Position = UD2(1, 24, 0, 0) }, 0.22)
            Tween(Holder, { Size = UD2(1, 0, 0, 0) }, 0.3, 1, function()
                if Holder.Parent then Holder:Destroy() end
            end)
        end
        local Close = Button("Close", Card, { Text = "×", Size = UFO(22, 22), AnchorPoint = V2(1, 0),
            Position = UD2(1, -10, 0, 12), TextColor3 = Theme.Placeholder, TextSize = 18 })
        Close.MouseButton1Click:Connect(Entry.Close)

        Live[#Live + 1] = Entry
        if #Live > NotifyMax then Live[1].Close() end

        CardSnap = Snapshot(Card)
        ApplySnapshot(CardSnap, 1)
        ApplySnapshot(CardSnap, 0, 0.34)
        Tween(Card, { Position = UD2(0, 0, 0, 0) }, 0.34, 0.78)
        local Dur = tonumber(Cfg.Duration)
        if not Dur or Dur <= 0 then Dur = 5 end
        if Content then
            local N = Graphemes(Content.ContentText)
            StopReveal = Reveal(Content, MM(MC(N * 0.024, 0.18, 2.2), Dur * 0.7))
        end
        BarTween = TweenService:Create(Bar, TI(Dur, ES.Linear), { Size = UD2(0, 0, 0, BarBody) })
        BarTween:Play()
        TDL(Dur, Entry.Close)
        return Entry
    end
end

-------------------------------------------------------------------------- loops

do
    local LoopFailLimit = 5
    local LoopsByType, Pumps = { PreRender = {}, Heartbeat = {}, Stepped = {} }, {}
    local Renamed = { RenderStepped = "PreRender" }
    local Pcall = pcall

    --!mv:omit
    local function Dispatch(Loops, ...)
        local N = #Loops
        if N == 0 then return end
        local Now, Dead = OC(), nil
        for I = 1, N do
            local Loop = Loops[I]
            if Loop.Removed then
                Dead = Dead or {}
                Dead[#Dead + 1] = I
                continue
            end
            local Run, Interval = Loop.Active, Loop.Interval
            if Loop.ShouldRun then Run = Loop.ShouldRun() end
            if not Run then continue end
            if Interval then
                if Now - Loop.Last < Interval then continue end
                Loop.Last = Now
            end
            local Ok, Err = Pcall(Loop.Func, ...)
            if Ok then Loop.Fails = nil; continue end
            Loop.Fails = (Loop.Fails or 0) + 1
            if Loop.Fails == 1 then
                Warn("a loop errored: %s", tostring(Err))
            elseif Loop.Fails >= LoopFailLimit then
                Loop.Removed = true
                Warn("loop retired after %d errors in a row: %s", LoopFailLimit, tostring(Err))
            end
        end
        if Dead then
            for I = #Dead, 1, -1 do TR(Loops, Dead[I]) end
        end
    end

    function Library:RegisterLoop(LoopType, Func, ShouldRun, Interval)
        LoopType = Renamed[LoopType] or LoopType
        local List = LoopsByType[LoopType]
        if not List then
            error(("SummitX: RegisterLoop(%q) -- use PreRender, Heartbeat or Stepped"):format(tostring(LoopType)), 2)
        end
        local Entry = { Func = Func, Active = true, ShouldRun = ShouldRun, Interval = Interval, Last = 0 }
        List[#List + 1] = Entry
        if not Pumps[LoopType] then
            Pumps[LoopType] = Lifetime.Add(RunService[LoopType]:Connect(function(...) Dispatch(List, ...) end))
        end
        return Entry
    end

    function Library:RemoveLoop(Entry)
        if Entry then Entry.Removed = true end
    end
end

-------------------------------------------------------------------------- game lookups

do
    local Failed = false

    function Library:Await(Parent, Name, Timeout)
        if typeof(Parent) ~= "Instance" then return nil end
        local Found = Parent:FindFirstChild(Name)
        if Found or Failed or not self:Allowed() then return Found end
        local Deadline, Settled = OC() + (Timeout or 10), nil
        while OC() < Deadline do
            task.wait(0.1)
            Found = Parent:FindFirstChild(Name)
            if Found then return Found end
            if game:IsLoaded() then
                Settled = Settled or OC()
                if OC() - Settled > 1.5 then break end
            end
        end
        Failed = true
        Warn("Await: %q never appeared under %s. Nothing after this will resolve either.", tostring(Name), Parent:GetFullName())
        return nil
    end

    function Library:Require(Module)
        if typeof(Module) ~= "Instance" or not Module:IsA("ModuleScript") then return nil end
        local Ok, Result = pcall(require, Module)
        if Ok then return Result end
        Warn("could not load %s: %s", Module:GetFullName(), tostring(Result))
        return nil
    end
end

-------------------------------------------------------------------------- config store

local function CloneValue(V) return type(V) == "table" and TC(V) or V end

local StoreClass = {}
StoreClass.__index = StoreClass

function StoreClass.new(Path)
    local self = setmetatable({ Path = Path, Flags = {}, Defaults = {}, Saved = {}, Dirty = false, Saving = false, Restoring = false }, StoreClass)
    if not Path then return self end
    local Legacy = Path:gsub("/" .. tostring(game.GameId) .. "%.json$", "/" .. tostring(game.PlaceId) .. ".json")
    local Raw = Env.ReadFile(Path) or (Legacy ~= Path and Env.ReadFile(Legacy)) or nil
    if not Raw then return self end
    local Ok, Data = pcall(HttpService.JSONDecode, HttpService, Raw)
    if Ok and type(Data) == "table" then
        self.Saved = Data
    else
        Warn("config at %q is unreadable; the next save replaces it", Path)
    end
    return self
end

function StoreClass:Apply(Slot, Value)
    local Now = Slot.Get()
    if Now ~= nil and type(Now) ~= type(Value) then return end
    self.Restoring = true
    local Ok, Err = pcall(Slot.Set, Value)
    self.Restoring = false
    if not Ok then Warn("restoring a saved setting errored: %s", tostring(Err)) end
end

function StoreClass:Register(Flag, Slot)
    if not Flag then return end
    if self.Flags[Flag] then
        Warn("duplicate flag %q -- the later widget wins and the earlier one stops saving. Pass a unique Flag.", Flag)
    end
    self.Flags[Flag] = Slot
    if self.Defaults[Flag] == nil then self.Defaults[Flag] = CloneValue(Slot.Get()) end
    local Saved = self.Saved[Flag]
    if Saved ~= nil then
        TDF(function()
            if self.Flags[Flag] == Slot then self:Apply(Slot, Saved) end
        end)
    end
end

function StoreClass:Unregister(Flag, Slot)
    if Flag and (Slot == nil or self.Flags[Flag] == Slot) then self.Flags[Flag] = nil end
end

function StoreClass:Save()
    if not (self.Path and Env.CanSave) then return end
    for Flag, Slot in self.Flags do self.Saved[Flag] = Slot.Get() end
    self.Dirty = false
    local Ok, Err = Env.WriteFile(self.Path, HttpService:JSONEncode(self.Saved))
    if not Ok then Warn("could not save config to %q: %s", self.Path, tostring(Err)) end
end

function StoreClass:MarkDirty(Flag)
    if self.Restoring or not Flag or not self.Path then return end
    self.Dirty = true
    if self.Saving then return end
    self.Saving = true
    TDL(2, function()
        self.Saving = false
        if self.Dirty and IsCurrent() then self:Save() end
    end)
end

function StoreClass:Reset()
    local N = 0
    self.Restoring = true
    for Flag, Default in self.Defaults do
        local Slot = self.Flags[Flag]
        if Slot then
            pcall(Slot.Set, CloneValue(Default))
            N += 1
        end
    end
    self.Restoring = false
    self.Saved, self.Dirty = {}, false
    if self.Path then Env.DeleteFile(self.Path) end
    return N
end

local function ActiveStore(Method, Flag)
    local Window = Library.Window
    local Store = Window and Window.Store
    if not Store then Warn("%s(%q): no window is built yet", Method, tostring(Flag)) end
    return Store
end

function Library:GetFlag(Flag)
    local Store = ActiveStore("GetFlag", Flag)
    local Slot = Store and Store.Flags[Flag]
    if Store and not Slot then Warn("GetFlag(%q): no widget owns that flag", tostring(Flag)) end
    if not Slot then return nil end
    return CloneValue(Slot.Get())
end

function Library:SetFlag(Flag, Value)
    local Store = ActiveStore("SetFlag", Flag)
    local Slot = Store and Store.Flags[Flag]
    if Store and not Slot then Warn("SetFlag(%q): no widget owns that flag", tostring(Flag)) end
    if not Slot then return false end
    Slot.Set(Value)
    return true
end

function Library:SaveConfig()
    local Store = ActiveStore("SaveConfig")
    if Store then Store:Save() end
end

function Library:ResetSettings()
    local Store = ActiveStore("ResetSettings")
    local N = Store and Store:Reset() or 0
    self:SetTheme(self.Palettes[1])
    return N
end

