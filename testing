        Box.Text = ""
        Box.PlaceholderText = Offline and "Couldn't reach the server" or "That key didn't work"
        TweenService:Create(Shell, TI(0.05, ES.Sine, Enum.EasingDirection.InOut, 4, true), { Rotation = 3 }):Play()
        TweenService:Create(CardStroke, TI(0.3, ES.Sine, Enum.EasingDirection.Out, 0, true),
