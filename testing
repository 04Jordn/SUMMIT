        else
            Library:Notify({ Title = "That key didn't work", Duration = 5, Content = "Copy the whole key from the Discord and paste it again." })
        end
    end

    local function Pass(ViaPremium)
        if Granted then return end
        Granted = true
        if DropPremium then DropPremium() end
        Tween(ShellScale, { Scale = 0.82 }, 0.2)
        ApplySnapshot(Snapshot(Card), 1, 0.2)
        TDL(0.28, function()
            Kgui:Destroy()
