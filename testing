-------------------------------------------------------------------------- animation

local Motors = {}
local Fades = {}
local WakeTick, Tween, CancelMotors, ApplySnapshot

do
local SpringEps, VThresh, PThresh, MaxStep = 0.0001, 0.001, 0.001, 0.05
local DefaultTime = 0.35
local Exp, Sqrt, Cos, Sin, Abs = math.exp, math.sqrt, math.cos, math.sin, math.abs
local Next = next
local Scratch, MotorDone = TCR(4), {}
local DecGoal, DecCur = TCR(4), TCR(4)

--!mv:omit
local function SpringCoeffs(Freq, Damp, Dt)
    local F = Freq * 6.283185307179586
    local Decay = Exp(-Damp * F * Dt)
    if Damp == 1 then
        local Fdt = F * Dt
        return (1 + Fdt) * Decay, Dt * Decay, -(F * F * Dt) * Decay, (1 - Fdt) * Decay
    end
    local W = F * Sqrt(1 - Damp * Damp)
    local I = Cos(W * Dt)
    local Y = W > SpringEps and Sin(W * Dt) / W or Dt
    local Z = Y * F
    return (I + Damp * Z) * Decay, Y * Decay, -(Z * F) * Decay, (I - Z * Damp) * Decay
end

--!mv:omit
local function StepMotors(Dt)
    if Dt > MaxStep then Dt = MaxStep end
    local Fired = 0
    for Obj, Props in Motors do
        for Prop, M in Props do
            local Settled, State = true, M.State
            local A, B, C, D = SpringCoeffs(M.Freq, M.Damp, Dt)
            for I = 1, M.Count do
                local Base = (I - 1) * 3
                local G = State[Base + 3]
                local Offset, V0 = State[Base + 1] - G, State[Base + 2]
                local P, V = Offset * A + V0 * B + G, Offset * C + V0 * D
                if Abs(V) < VThresh and Abs(P - G) < PThresh then P, V = G, 0 else Settled = false end
                State[Base + 1], State[Base + 2] = P, V
                Scratch[I] = P
            end
            Obj[Prop] = M.Compose(Scratch)
            if Settled then
                Props[Prop] = nil
                if M.Done then Fired += 1; MotorDone[Fired] = M.Done end
            end
        end
        if Next(Props) == nil then Motors[Obj] = nil end
    end
    for I = 1, Fired do
        local Fn = MotorDone[I]
        MotorDone[I] = nil
        TSP(Fn)
    end
end

--!mv:omit
local function WriteSnap(Snap, Alpha)
    if Snap.Alpha == Alpha then return end
    Snap.Alpha = Alpha
    local Pane, Inner = Snap.Pane, MM(1, Alpha * Snap.Lead)
    for I = 1, #Snap, 3 do
        local Base = Snap[I + 2]
        local A = (not Pane or Pane[Snap[I]]) and Alpha or Inner
        Snap[I][Snap[I + 1]] = Base + (1 - Base) * A
    end
end

local FadeDone = {}
--!mv:omit
local function StepFades()
    local Now, Fired = OC(), 0
    for Snap, F in Fades do
        local A = (Now - F.Start) / F.Duration
        if A >= 1 then
            A = 1
            Fades[Snap] = nil
            if F.Done then Fired += 1; FadeDone[Fired] = F.Done end
        end
        A = 1 - (1 - A) * (1 - A)
        WriteSnap(Snap, F.From + (F.To - F.From) * A)
    end
    for I = 1, Fired do
        local Fn = FadeDone[I]
        FadeDone[I] = nil
        Fn()
    end
end

local TickConn
--!mv:omit
local function Tick(Dt)
    StepMotors(Dt)
    StepFades()
    if Next(Motors) == nil and Next(Fades) == nil then
        TickConn:Disconnect()
        TickConn = nil
    end
end
--!mv:omit
function WakeTick()
    if not TickConn then TickConn = RunService.PreRender:Connect(Tick) end
end

--!mv:omit
function ApplySnapshot(Snap, Alpha, Time, OnDone)
    if not Time or Time <= 0 then
        Fades[Snap] = nil
        WriteSnap(Snap, Alpha)
        if OnDone then OnDone() end
        return
    end
    Fades[Snap] = { From = Snap.Alpha or 0, To = Alpha, Duration = Time, Done = OnDone, Start = OC() }
    WakeTick()
end


local NewColor3 = Color3.new
--!mv:omit
local function CNumber(C) return C[1] end
--!mv:omit
local function CColor3(C) return NewColor3(MC(C[1], 0, 1), MC(C[2], 0, 1), MC(C[3], 0, 1)) end
--!mv:omit
local function CUDim2(C) return UD2(C[1], C[2], C[3], C[4]) end
--!mv:omit
local function CUDim(C) return UD(C[1], C[2]) end
--!mv:omit
local function CVector2(C) return V2(C[1], C[2]) end
local Decompose = {
    number = function(V, Into) Into[1] = V; return 1, CNumber end,
    Color3 = function(V, Into) Into[1], Into[2], Into[3] = V.R, V.G, V.B; return 3, CColor3 end,
    UDim2 = function(V, Into) Into[1], Into[2], Into[3], Into[4] = V.X.Scale, V.X.Offset, V.Y.Scale, V.Y.Offset; return 4, CUDim2 end,
    UDim = function(V, Into) Into[1], Into[2] = V.Scale, V.Offset; return 2, CUDim end,
    Vector2 = function(V, Into) Into[1], Into[2] = V.X, V.Y; return 2, CVector2 end,
}

--!mv:omit
function Tween(Obj, Props, Time, Damping, OnDone)
    local Freq = MC(1 / MX(Time or DefaultTime, 0.05), 2, 14)
    local Damp = MC(Damping or 1, 0.05, 1)
    local Reg = Motors[Obj]
    if not Reg then Reg = {}; Motors[Obj] = Reg end
    local Pending = OnDone
    for Prop, Goal in Props do
        local Cur = Obj[Prop]
        if Cur == Goal then Reg[Prop] = nil; continue end
        local Dg, Dc = Decompose[typeof(Goal)], Decompose[typeof(Cur)]
        local Gn, Kind
        if Dg and Dc then Gn, Kind = Dg(Goal, DecGoal) end
        if not Gn or Dc(Cur, DecCur) ~= Gn then Obj[Prop] = Goal; continue end
        local M = Reg[Prop] or {}
        local State = M.State
        if not State or #State ~= Gn * 3 then State = TCR(Gn * 3) end
        for I = 1, Gn do
            local Base = (I - 1) * 3
            State[Base + 1], State[Base + 2], State[Base + 3] = DecCur[I], State[Base + 2] or 0, DecGoal[I]
        end
        M.State, M.Count, M.Freq, M.Damp, M.Compose, M.Goal, M.Done = State, Gn, Freq, Damp, Kind, Goal, Pending
        Reg[Prop], Pending = M, nil
    end
    if Pending then TDF(Pending) end
    if Next(Reg) == nil then Motors[Obj] = nil else WakeTick() end
end
end

--!mv:omit
function CancelMotors(Obj, Prop)
    local Reg = Motors[Obj]
    if not Reg then return nil end
    if Prop == nil then Motors[Obj] = nil; return nil end
    local M = Reg[Prop]
    if not M then return nil end
    Reg[Prop] = nil
    if next(Reg) == nil then Motors[Obj] = nil end
    return M.Goal
end

-------------------------------------------------------------------------- snapshot fades

local FadeTime, InnerLead = 0.22, 1.9
local Snapshot, FadeOut
do
local KNone, KGui, KText, KImage, KScroll, KStroke = 0, 1, 2, 3, 4, 5
local KindByClass = {
    Frame = KGui, CanvasGroup = KGui, ViewportFrame = KGui, VideoFrame = KGui,
    TextLabel = KText, TextButton = KText, TextBox = KText,
    ImageLabel = KImage, ImageButton = KImage, ScrollingFrame = KScroll, UIStroke = KStroke,
}
local Transparency = { [KText] = "TextTransparency", [KImage] = "ImageTransparency", [KScroll] = "ScrollBarImageTransparency" }

local KindOrder = {
    { "UIStroke", KStroke }, { "ScrollingFrame", KScroll }, { "TextLabel", KText }, { "TextButton", KText },
    { "TextBox", KText }, { "ImageLabel", KImage }, { "ImageButton", KImage }, { "GuiObject", KGui },
}

--!mv:omit
local function KindOf(Inst)
    local Cls = Inst.ClassName
    local K = KindByClass[Cls]
    if K ~= nil then return K end
    K = KNone
    for _, Pair in KindOrder do
        if Inst:IsA(Pair[1]) then K = Pair[2]; break end
    end
    KindByClass[Cls] = K
    return K
end

--!mv:omit
local function Rest(V, Prop)
    local Goal = CancelMotors(V, Prop)
    if Goal == nil then return V[Prop] end
    V[Prop] = Goal
    return Goal
end

--!mv:omit
local function Push(Snap, N, Inst, Prop)
    local T = Rest(Inst, Prop)
    if T >= 1 then return N end
    Snap[N + 1], Snap[N + 2], Snap[N + 3] = Inst, Prop, T
    return N + 3
end

--!mv:omit
local function Walk(Inst, Snap, N, Skip)
    if Skip and Skip[Inst] then return N end
    local Kind = KindOf(Inst)
    if Kind == KStroke then return Push(Snap, N, Inst, "Transparency") end
    if Kind ~= KNone then
        if not Inst.Visible then return N end
        N = Push(Snap, N, Inst, "BackgroundTransparency")
        local Prop = Transparency[Kind]
        if Prop then N = Push(Snap, N, Inst, Prop) end
    end
    for _, Child in Inst:GetChildren() do N = Walk(Child, Snap, N, Skip) end
    return N
end

function Snapshot(Root, Skip, Pane)
    local Snap = TCR(1024)
    Walk(Root, Snap, 0, Skip)
    Snap.Pane, Snap.Lead = Pane, InnerLead
    return Snap
end


function FadeOut(Inst)
    if typeof(Inst) ~= "Instance" or not Inst.Parent then return end
    ApplySnapshot(Snapshot(Inst), 1, FadeTime, function() pcall(Inst.Destroy, Inst) end)
end
end

-------------------------------------------------------------------------- menu fader

local FaderClass = {}
FaderClass.__index = FaderClass

function FaderClass.new(Root, Skip, Pane, BeforeSnap)
    return setmetatable({ Root = Root, Skip = Skip, Pane = Pane, BeforeSnap = BeforeSnap, Snap = nil, Busy = false, Gen = 0 }, FaderClass)
end

function FaderClass:Capture()
    if not self.Busy then
        if self.BeforeSnap then self.BeforeSnap() end
        self.Snap = Snapshot(self.Root, self.Skip, self.Pane)
    end
    return self.Snap
end

function FaderClass:Alpha() return (self.Snap and self.Snap.Alpha) or 0 end

function FaderClass:Show(Show)
    self.Gen += 1
    local Gen, Root = self.Gen, self.Root
    if Show then
        Root.Visible = true
        local Snap = self.Snap
        if not Snap then return end
        self.Busy = true
        ApplySnapshot(Snap, 1)
        ApplySnapshot(Snap, 0, FadeTime, function() if Gen == self.Gen then self.Busy = false end end)
    else
        local Snap = self:Capture()
        self.Busy = true
        ApplySnapshot(Snap, 1, FadeTime, function()
            if Gen ~= self.Gen then return end
            self.Busy = false
            Root.Visible = false
        end)
    end
end

function FaderClass:Out(Time)
    self.Gen += 1
    local Snap = self:Capture()
    self.Busy = true
    ApplySnapshot(Snap, 1, Time)
end

function FaderClass:In(Time)
    self.Gen += 1
    local Gen, Snap = self.Gen, self.Snap
    if not Snap then return end
    ApplySnapshot(Snap, 0, Time, function() if Gen == self.Gen then self.Busy = false end end)
end

--!mv:omit
function FaderClass:SetRest(Inst, Prop, Value)
    CancelMotors(Inst, Prop)
    local Snap = self.Snap
    local A = (Snap and Snap.Alpha) or 0
    if A <= 0 then Inst[Prop] = Value; return end
    local Pane = Snap.Pane
    local At = (not Pane or Pane[Inst]) and A or MM(1, A * InnerLead)
    local N = #Snap
    for I = 1, N, 3 do
        if Snap[I] == Inst and Snap[I + 1] == Prop then
            Snap[I + 2] = Value
            Inst[Prop] = Value + (1 - Value) * At
            return
        end
    end
    Snap[N + 1], Snap[N + 2], Snap[N + 3] = Inst, Prop, Value
    Inst[Prop] = Value + (1 - Value) * At
end

