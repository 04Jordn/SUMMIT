local Paint = { Guis = {}, Grad = {}, Spec = {}, KeyOf = {} }

--!mv:omit
function Paint.Id(C)
    return MR(C.R * 255) * 65536 + MR(C.G * 255) * 256 + MR(C.B * 255)
end

function Paint.Index()
    TCL(Paint.KeyOf)
    for K, V in Theme do Paint.KeyOf[Paint.Id(V)] = K end
end
Paint.Index()

function Paint.GlassSeq(Base)
    return ColorSequence.new(Base:Lerp(Theme.GlassLift, 0.13), Base:Lerp(Theme.GlassFall, 1.00))
end

function Paint.EdgeSeq(Base)
    return ColorSequence.new({
        CSK(0.00, Base:Lerp(Theme.Active, 0.60)),
        CSK(0.32, Base:Lerp(Theme.Accent, 0.30)),
        CSK(0.70, Base),
        CSK(1.00, Base:Lerp(ColorBlack, 0.55)),
    })
end

function Paint.Note(Gradient, Kind, Base)
    local Key = Paint.KeyOf[Paint.Id(Base)]
    if Key then Paint.Grad[#Paint.Grad + 1] = { Gradient, Kind, Key } end
end

function Paint.NoteSpec(Spec, Target)
    if type(Spec) ~= "table" then return end
    local List = Paint.Spec
    for K, V in Spec do
        local Key = typeof(V) == "Color3" and Paint.KeyOf[Paint.Id(V)] or nil
        if Key then List[#List + 1] = { Spec, K, Key, Target } end
    end
    if #List <= 96 then return end
    for I = #List, 1, -1 do
        if not List[I][4].Parent then TR(List, I) end
    end
end

do
    local DefaultTheme = TC(Theme)
    local BaseHue = 0.687
    local Fixed = { Bad = true }
    local Palettes = {
        { Name = "Violet",   Hue = 0.687 },
        { Name = "Indigo",   Hue = 0.630, Sat = 0.85, Accent = RGB(104, 128, 238) },
        { Name = "Ocean",    Hue = 0.545, Sat = 0.55, Accent = RGB(64, 176, 200) },
        { Name = "Emerald",  Hue = 0.405, Sat = 0.42, Accent = RGB(70, 191, 133) },
        { Name = "Amber",    Hue = 0.085, Sat = 0.26, Accent = RGB(230, 163, 66) },
        { Name = "Crimson",  Hue = 0.985, Sat = 0.34, Accent = RGB(226, 86, 102) },
        { Name = "Rose",     Hue = 0.928, Sat = 0.30, Accent = RGB(224, 143, 178) },
        { Name = "Graphite", Hue = 0.600, Sat = 0.10, Accent = RGB(148, 157, 180) },
        { Name = "Onyx",     Hue = 0.600, Sat = 0.00, Accent = RGB(176, 180, 190) },
    }
    local TintProps = {
        Frame = { "BackgroundColor3" },
        ScrollingFrame = { "BackgroundColor3", "ScrollBarImageColor3" },
        TextLabel = { "BackgroundColor3", "TextColor3" },
        TextButton = { "BackgroundColor3", "TextColor3" },
        TextBox = { "BackgroundColor3", "TextColor3", "PlaceholderColor3" },
        ImageLabel = { "BackgroundColor3", "ImageColor3" },
        ImageButton = { "BackgroundColor3", "ImageColor3" },
        UIStroke = { "Color" },
    }

    local function Rotate(C, Dh, Sat)
        local H, S, V = C:ToHSV()
        if S < 0.02 then return C end
        return Color3.fromHSV((H + Dh) % 1, MC(S * Sat, 0, 1), V)
    end

    local function Build(P)
        local Out = {}
        local Dh, Sat = (P.Hue - BaseHue) % 1, P.Sat or 1
        local Identity = Dh == 0 and Sat == 1
        for K, C in DefaultTheme do
            Out[K] = (Identity or Fixed[K]) and C or Rotate(C, Dh, Sat)
        end
        if P.Accent then
            Out.Accent = P.Accent
            Out.Active = P.Accent:Lerp(ColorWhite, 0.22)
            Out.ToggleBorder = P.Accent:Lerp(ColorBlack, 0.34)
        end
        local Seen = {}
        for K, C in Out do
            local Id = Paint.Id(C)
            for _ = 1, 8 do
                if not Seen[Id] then break end
                C = Color3.new(C.R, C.G, MC(C.B + 1 / 255, 0, 1))
                Id = Paint.Id(C)
            end
            Seen[Id], Out[K] = true, C
        end
        return Out
    end

    --!mv:omit
    local function Retint(Inst, Palette)
        local Props = TintProps[Inst.ClassName]
        if not Props then return end
        for I = 1, #Props do
            local Prop = Props[I]
            local Key = Paint.KeyOf[Paint.Id(Inst[Prop])]
            if Key then
                CancelMotors(Inst, Prop)
                Inst[Prop] = Palette[Key]
            end
        end
    end

    local function Find(Name)
        for _, P in Palettes do
            if P.Name == Name then return P end
        end
        return nil
    end

    function Paint.Apply(Name)
        local Chosen = Find(Name)
        if not Chosen then return false end
        if Chosen.Name == Library.Palette then return true end
        local Palette = Build(Chosen)
        for I = #Paint.Guis, 1, -1 do
            local Gui = Paint.Guis[I]
            if not Gui.Parent then TR(Paint.Guis, I); continue end
            for _, D in Gui:GetDescendants() do Retint(D, Palette) end
        end
        for _, E in Paint.Spec do E[1][E[2]] = Palette[E[3]] end
        for K, V in Palette do Theme[K] = V end
        Paint.Index()
        for I = #Paint.Grad, 1, -1 do
            local G = Paint.Grad[I]
            if not G[1].Parent then TR(Paint.Grad, I); continue end
            local Base = Theme[G[3]]
            G[1].Color = G[2] == "glass" and Paint.GlassSeq(Base) or Paint.EdgeSeq(Base)
        end
        Library.Palette = Chosen.Name
        return true
    end

    local Names = {}
    for I, P in Palettes do Names[I] = P.Name end
    Library.Palettes = table.freeze(Names)
    Library.Palette = Palettes[1].Name
end

Private.Folder = "SummitX"

function Private.ThemeFile() return Private.Folder .. "/theme.txt" end

function Private.RestoreTheme()
    local Saved = Env.ReadFile(Private.ThemeFile())
    if Saved then Paint.Apply((Saved:gsub("%s", ""))) end
end

function Library:SetTheme(Name)
    if not Paint.Apply(Name) then
        Warn("SetTheme(%q): no palette by that name", tostring(Name))
        return false
    end
    Env.WriteFile(Private.ThemeFile(), self.Palette)
    if Private.ThemeRow and Private.ThemeRow.Get() ~= self.Palette then Private.ThemeRow.Set(self.Palette) end
    return true
end

