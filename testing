            HorizontalAlignment = HFA.Right, Padding = UD(0, 10) })
        return ToastHolder
    end

    local function Graphemes(S)
        local N = 0
        for _ in utf8.graphemes(S) do N += 1 end
        return N
    end

    local function Reveal(Label, Time)
        local Total = Graphemes(Label.ContentText)
        if Total == 0 or Time <= 0 then return function() end end
        Label.MaxVisibleGraphemes = 0
        local Conn, T0 = nil, OC()
        local function Stop()
            if Conn then Conn:Disconnect(); Conn = nil end
            Label.MaxVisibleGraphemes = -1
        end
        Conn = RunService.Heartbeat:Connect(function()
            local A = (OC() - T0) / Time
            if not Label.Parent or A >= 1 then Stop(); return end
            Label.MaxVisibleGraphemes = math.floor(Total * A)
        end)
        return Stop
    end

    function Library:Notify(Cfg)
        Cfg = type(Cfg) == "table" and Cfg or { Content = tostring(Cfg) }
        Order += 1
        local Holder = Create("Frame", Layer(), { Size = UD2(1, 0, 0, 0), AutomaticSize = AS.Y,
