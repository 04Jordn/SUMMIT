--!mv:vm
local function PremiumNag()
    local Url = Private.StoreUrl
    if Url then Env.Copy(Url) end
    Library:Notify({ Title = "Premium only", Duration = 6, Content = Url
        and ("This feature needs Premium. Get it at " .. (Url:gsub("^%w+://", "")) .. " — link copied.")
