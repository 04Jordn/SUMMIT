        local Hooks = {}
        for Fn in PremiumHooks do Hooks[#Hooks + 1] = Fn end
        for _, Fn in Hooks do TSP(Fn, Value) end
    end
end

function Library:OnPremiumChanged(Fn)
    if type(Fn) ~= "function" then return function() end end
    PremiumHooks[Fn] = true
    return function() PremiumHooks[Fn] = nil end
end
Lifetime.Add(function() TCL(PremiumHooks) end)

local function Locked(Props) return Props.Premium and not Private.Premium end

