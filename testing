do
    local NotifyMax, BarBody = 6, 40
    local Live, ToastHolder, Order = {}, nil, 0

    local function Layer()
        if ToastHolder and ToastHolder.Parent then return ToastHolder end
        local Gui = Mount(10000)
        ToastHolder = Create("Frame", Gui, { AnchorPoint = V2(1, 1), Position = UD2(1, -18, 1, -18),
