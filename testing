do
    local Keyboard, Backspace, Escape = UIT.Keyboard, Enum.KeyCode.Backspace, Enum.KeyCode.Escape

    local function Typing()
        if UserInputService:GetFocusedTextBox() then return true end
        local Chat = game:FindService("TextChatService")
        Chat = Chat and Chat:FindFirstChild("ChatInputBarConfiguration")
        return Chat ~= nil and Chat.IsFocused
    end

    Lifetime.Add(UserInputService.InputBegan:Connect(function(Io)
        if Io.UserInputType ~= Keyboard then return end
        local Name = Io.KeyCode.Name
        local Armed = Pending
        if Armed and not UserInputService:GetFocusedTextBox() then
            Pending = nil
            Armed:Capture((Io.KeyCode == Backspace or Io.KeyCode == Escape) and "NONE" or Name)
            return
        end
        if Io.KeyCode == Escape then
            local Box = UserInputService:GetFocusedTextBox()
            if Box then Box:ReleaseFocus(); return end
            if Surface.Owner then Surface.Close(); return end
        end
        if Private.SliderDragging or Typing() then return end
        for Entry in Binds do
            if Entry.Key == Name then Entry:Press() end
        end
    end))

    Lifetime.Add(UserInputService.InputEnded:Connect(function(Io)
        if Io.UserInputType ~= Keyboard then return end
        local Name = Io.KeyCode.Name
        for Entry in Binds do
            if Entry.Key == Name then Entry:Release() end
        end
    end))
end

