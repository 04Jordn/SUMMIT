        local OkGet, Body = pcall(game.HttpGet, game, Url)
        return OkGet and Body or nil
    end

    function Env.ReadFile(Path)
        if not Env.CanSave then return nil end
        local OkRead, Data = pcall(function() return isfile(Path) and readfile(Path) or nil end)
        return OkRead and Data or nil
    end

    function Env.WriteFile(Path, Data)
        if not Env.CanSave then return false end
        return pcall(function()
            local Dir
            for Seg in Path:gmatch("([^/]+)/") do
                Dir = Dir and (Dir .. "/" .. Seg) or Seg
                if not isfolder(Dir) then makefolder(Dir) end
            end
            writefile(Path, Data)
        end)
    end

    function Env.DeleteFile(Path)
        if Env.CanSave then pcall(delfile, Path) end
    end
end

