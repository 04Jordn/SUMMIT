local Surface = { Views = {} }

function Surface.Mount(Window)
    if Surface.Window == Window and Surface.Portal.Parent then return end
    local Portal = Create("Frame", Window.PageHost, { BackgroundTransparency = 1, Visible = false })
    local Panel = Create("TextButton", Portal, { Size = UD2(1, 0, 1, -L.PadY), BackgroundColor3 = Theme.Sidebar, BackgroundTransparency = 0.02 })
    Decorate(Panel, L.Corner8, { Theme.WindowStroke, 0.35, 1.2 })
    Surface.Window, Surface.Portal, Surface.Panel = Window, Portal, Panel
    Surface.Owner, Surface.Views = nil, {}
end

function Surface.View(Kind, Build)
    local View = Surface.Views[Kind]
    if View then return View end
    View = Build(Surface.Panel)
    Surface.Views[Kind] = View
    return View
end

function Surface.IsOpen(Owner) return Owner ~= nil and Surface.Owner == Owner end

function Surface.Place()
    local Owner = Surface.Owner
    if not Owner then return end
    local Sc = MX(Surface.Window.Scale.Scale, 0.01)
    Surface.Portal.Position = UD2(0, L.PadX, 0, Owner.Content.AbsoluteSize.Y / Sc - 4)
    Surface.Portal.Size = UD2(1, -L.PadX * 2, 0, Owner.Height() + L.PadY)
end

function Surface.Reveal(Row)
    local Page = Surface.Owner and Surface.Owner.Clip
    if not Page then return end
    local Sc = MX(Surface.Window.Scale.Scale, 0.01)
    local Portal = Surface.Portal
    local Bottom = Row.AbsolutePosition.Y - Page.AbsolutePosition.Y + Page.CanvasPosition.Y
        + (Portal.Position.Y.Offset + Portal.Size.Y.Offset) * Sc
    local Want = Bottom + 8 - Page.AbsoluteSize.Y
    if Want > Page.CanvasPosition.Y then Page.CanvasPosition = V2(0, Want) end
end

function Surface.Open(Window, Owner, Row)
    Surface.Mount(Window)
    if Surface.Owner ~= Owner then Surface.Close() end
    Surface.Owner = Owner
    for Kind, View in Surface.Views do View.Frame.Visible = Kind == Owner.Kind end
    Surface.Portal.Parent = Row
    Surface.Place()
    Surface.Portal.Visible = true
    Surface.Watch = Owner.Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(Surface.Place)
    Surface.Outside = UserInputService.InputBegan:Connect(function(Input)
        if not IsPress(Input.UserInputType) then return end
        local At, Pos, Size = Input.Position, Row.AbsolutePosition, Row.AbsoluteSize
        if At.X >= Pos.X and At.X <= Pos.X + Size.X and At.Y >= Pos.Y and At.Y <= Pos.Y + Size.Y then return end
        Surface.Close()
    end)
    Surface.Reveal(Row)
    Owner.Clip:GetPropertyChangedSignal("AbsoluteCanvasSize"):Once(function() Surface.Reveal(Row) end)
end

function Surface.Close(Owner)
    local Current = Surface.Owner
    if not Current or (Owner and Owner ~= Current) then return end
    Surface.Owner = nil
    if Surface.Watch then Surface.Watch:Disconnect(); Surface.Watch = nil end
    if Surface.Outside then Surface.Outside:Disconnect(); Surface.Outside = nil end
    Surface.Portal.Visible = false
    Surface.Portal.Parent = Surface.Window.PageHost
    Current.OnClose()
end

